---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Tags from '../components/Tags.astro'
import { render, type CollectionEntry } from 'astro:content';
import Toc from '../components/Toc.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props as Props;

const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, heroImage } = post.data; 


---

<html lang="zh-TW">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 0.5rem);
				margin: auto;
				padding: 0.5rem 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 3rem;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main >
			<div class="three-column-layout ">
				<!-- 左邊欄 -->
				<aside class="sidebar desktop-toc">
				<div class="nav-card ">
					<h4>目錄</h4>
					<Toc headings={headings} />
				</div>
				</aside>

				<!-- 中間欄 -->
				<article class="center-content">
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					<div class="prose">
						<div class="title">
							<h1>{title}</h1>
							
							<div class="date">
								<FormattedDate date={pubDate} />
									<aside class="sidebar mobile-toc">
										<details open class="nav-card">
											<summary>
											<h4>目錄</h4>
											</summary>
											<div class="toc-content">
											<Toc headings={headings} />
											</div>
										</details>
									</aside>
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							
						</div>
						<div class="mk">
							<Content />
						</div>
					</div>
				</article>

				<!-- 右邊攔 -->
				<aside class="sidebar">
    			<div class="sticky-card">
					<Tags variant="page"/>
				</div>
  				</aside>	
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	
	/* 目錄 */
	.sidebar{
		background-color: #cfdfe4; 
		padding: 2rem ;
		border-radius: 1rem;
	}
	/* 讓 details / summary 看起來像個卡片 */
	.nav-card {
	overflow: hidden;
	}

	/* 標題欄位設定 */
	.nav-card summary {
	cursor: pointer;
	user-select: none;
	display: flex;
	justify-content: space-between;
	align-items: center;
	list-style: none;
	}

	/* 針對 Safari 移除預設箭頭 */
	.nav-card summary::-webkit-details-marker {
	display: none;
	}

	/* 標題文字調整 */
	.nav-card summary h4 {
	margin: 0;
	display: inline-block;
	font-size: 1.125rem;
	}

	/* 自訂右側的 +/- 或箭頭符號 (這裡示範用 CSS 做小箭頭) */
	.nav-card summary::after {
	content: "›";
	font-size: 1.25rem;
	font-weight: bold;
	transition: transform 0.2s ease;
	}

	/* 當 details 展開 (open) 時，讓箭頭旋轉 90 度 */
	.nav-card[open] summary::after {
	transform: rotate(90deg);
	}

	/* 展開後的目錄內容區塊內縮 */
	.toc-content {
	margin-top: 1rem;
	border-top: 1px solid #748097;
	}

	.desktop-toc {
		display: none;
	}
	.center-content{
		margin-bottom: 2rem;
	}
	.mobile-toc {
		display: block;
		background-color: #cfdfe4; 
		margin-top: 2rem;
		padding: 2rem;
		border-radius: 1rem;
		text-align: left;
	}
	.nav-card ul {
	list-style: none;
	padding: 0;
	}
	.nav-card li {
	margin-bottom: 0.8rem;
	}
	.nav-card a {
	color: #000000;
	text-decoration: none;
	transition: color 0.2s;
	}
	.nav-card a:hover {
	color: #3182ce; /* 滑鼠移上去變藍色 */
	}

	/* markdown */
	.mk :global(h1) {
	font-size: 1.75rem;
	font-weight: bold;
	margin: 1.5rem 0;
	}
	.mk :global(h2) {
	font-size: 1.5rem;
	margin: 1.5rem 0;
	}
	.mk :global(h3) {
	font-size: 1.3rem;
	font-weight: bold;
	margin: 1rem 0;
	}
	.mk :global(h4) {
	font-size: 1.25rem;
	font-weight: bold;
	margin: 1rem 0;
	}
	.mk :global(h5) {
	font-size: 1rem;
	font-weight: bold;
	margin: 1rem 0;
	}
	.mk :global(hr) {
	border: none;
	border-top: 1px solid rgb(var(--gray-light));
	margin: 1.25rem 0;
	}
	.mk :global(p) {
	margin-bottom: 1rem;
	font-size: 1.1rem;
	}
	.mk :global(ul) {
	padding-left: 0;
	margin-left: 0;
	list-style-position: inside; /* 讓點點（圓點）留在行內，不向外突出 */
	}
	.mk :global(ul li) {
	font-size: 1.1rem;
	line-height: 2.5;
	margin-left: 0;
  	padding-left: 0;
	}
	.mk :global(ol) {
	padding-left: 0;
	margin-left: 0;
	list-style-position: inside; /* 讓點點（圓點）留在行內，不向外突出 */
	}
	.mk :global(ol li) {
	font-size: 1.1rem;
	line-height: 2.5;
	margin-left: 0;
  	padding-left: 0;
	}
	.mk :global(ol li)::marker {
	color: #bbc4db;        /* 改顏色（例如藍色） */
	font-weight: bold;     /* 數字加粗 */
	font-size: 1.1em;      /* 數字稍大一點 */
	font-family: monospace; /* 等寬字體 */
	}
	.mk :global(img) {
	margin: auto;
	margin-bottom: 1.5rem;
	}

	@media (min-width: 1024px) {
		main{
			width: 100%;
			padding: 0;
		}
		.desktop-toc {
			display: block; /* 電腦版：讓側邊欄目錄顯示出來 */
		}

		.mobile-toc {
			display: none; /* 電腦版：隱藏內文裡的目錄，避免重複顯示！ */
		}
		/* 外層容器：分成 3 欄 */
		.three-column-layout {
		display: grid;
		grid-template-columns: 1fr 3.5fr 1fr;
		gap: 0; /* 👈 如果不想要欄位之間有縫隙，可以設為 0 */
		width: 100%;
		margin: 0;
		padding: 0;
		}

		/* 左、右側欄的基礎卡片樣式 */
		.nav-card, .sticky-card {
		position: sticky;
		top: 7rem;
		}

		.center-content{
			margin-top: 1rem;
		}
		.sidebar{
			padding: 3rem 2rem 2rem;
		}
		/* 簡單調整左側連結清單樣式 */
		
		/* markdown */
	.mk :global(hr) {
	margin: 3rem 0;
	}
	.mk :global(h1) {
	font-size: 2.85rem;
	margin-top: 2rem ;
	}
	.mk :global(h2) {
	font-size: 2.5rem;
	margin-top: 2rem ;
	}
	.mk :global(h3) {
	font-size: 2.1rem;
	margin-top: 3rem ;
	}
	.mk :global(h4) {
	font-size: 1.8rem;
	margin-top: 3rem ;
	}
	.mk :global(h5) {
	font-size: 1.5rem;
	margin-top: 3rem ;
	}
	.mk :global(p) {
	font-size: 1.5rem;
	margin-bottom: 3rem ;
	}
	.mk :global(ul li) {
	font-size: 1.5rem;
	}
	.mk :global(ol li) {
	font-size: 1.5rem;
	}
	}
</style>

