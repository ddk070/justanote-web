---
const today = new Date();
---

<footer>
	<div class="social-links">
		<a href="/">主頁</a>
		<a href="/blog/">筆記</a>
		<a href="/about/">關於</a>
		
	</div>
	&copy; {today.getFullYear()} 只是個筆記庫. 版權所有

</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-bottom: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
	.social-links a:not(:last-child)::after {
	content: "|";
	display: inline-block;
	margin-left: 1rem;   /* 離左邊文字的距離 */
	color: #aaa;         /* 調淡一點才不會搶視覺 */
	font-weight: 300;    /* 讓線條細一點，更精細 */
	}
</style>
