---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import ColorTag from '../../components/ColorTag.astro'

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);


//數文章數量
const tagsCount: Record<string, number> = {};

posts.forEach(post => {
    const tags: string[] = post.data.tags || [];

    tags.forEach(name => {
        tagsCount[name] = (tagsCount[name] || 0) + 1;
    });
});

---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;             /* 手機版佔滿螢幕 */
				max-width: 100%;
				padding: 1rem;           /* 左右留白呼吸空間 */
				box-sizing: border-box;
				margin-top: 1rem;
			}

			ul {
				display: flex;
				flex-wrap: wrap;
				align-items: stretch;
				gap: 20px;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}

			ul li {
				width: 100%;
				border-radius: 0.5rem;
				padding: 0;
				text-align: center;
				box-sizing: border-box;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
				overflow: hidden;
			}

			ul li:hover {
				transform: translateY(-4px);
				box-shadow: 0 8px 20px rgba(180, 180, 180, 0.1);
			}

			ul li:hover .article-maya {
				background: #c8dcfa;
			}

			ul li * {
				text-decoration: none;
			}

			ul li a {
				display: flex;
				flex-direction: column;
				justify-content: center;
				width: 100%;
				padding: 2rem 2.5rem 1.5rem;
				box-sizing: border-box;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;        /* 手機版行高稍寬避免壓迫 */
				font-size: 1.35rem;      /* 一般卡片標題手機版尺寸 */
			}
			ul li:first-child .title {
				font-size: 1.75rem;      /* 手機版第一篇大標題縮小一點，避免折太多行 */
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.count {
				color: #7c7c7c;
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (min-width: 1024px) {
				main {
					width: 70%;
					padding: 0;
					margin: 3rem auto;          /* 恢復原本電腦版的無外襯 */
				}
			
				ul {
					display: flex;
					flex-wrap: wrap;
					align-items: stretch;
					gap: 20px;
					list-style-type: none;
					margin: 0;
					padding: 0;
				}

				ul li {
					display: flex;
					width: calc(50% - 1rem);
					padding: 0;
					border-radius: 2rem;
					overflow: hidden;
					box-sizing: border-box;
				}

				ul li > .article-card {
					flex: 1;
					width: 100%;
				}

				ul li a {
					display: flex;
					flex-direction: column;
					justify-content: center;
					width: 100%;
					padding: 2rem 2.5rem 1.5rem;
					box-sizing: border-box;
				}
				
				ul li:first-child {
					width: 100%;
					margin-bottom: 1rem;
				}

				ul li:first-child .title {
					font-size: 2.369rem;
				}

				.title {
					line-height: 1;
					font-size: 2.369rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>MAYA 筆記</h1>
				<p class="count">目前筆記數量 ： <span> {tagsCount["maya"] ?? 0}</span></p>
				<hr>
				<ul>
				{
					posts.map((post) => (
						<li>
							<ColorTag tags={post.data.tags}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image
											width={720}
											height={360}
											src={post.data.heroImage}
											alt=""
										/>
									)}
									<h1 class="title">{post.data.title}</h1>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</ColorTag>
						</li>
					))
				}
			</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
